# Copy to a server-local .env.production. Never commit the real file.
POSTGRES_DB=microchips
POSTGRES_USER=microchips
POSTGRES_PASSWORD=replace-with-a-strong-secret
LARAVEL_APP_KEY=replace-with-output-of-php-artisan-key-generate-show
NEXT_REVALIDATE_SECRET=replace-with-a-long-random-secret-at-least-32-characters
LEAD_PROXY_SECRET=replace-with-a-separate-long-random-secret-at-least-32-characters
DEFAULT_SITE_HOST=microchips.by
PUBLIC_APP_URL=https://microchips.by
BACKEND_PORT=8080
FRONTEND_PORT=3000
